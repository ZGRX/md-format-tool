{
  "name": "md-format-tool",
  "version": "0.1.0",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node obsidian/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:obsidian": "tsc --noEmit && node obsidian/build.mjs"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.73.0",
    "mathjax-full": "^3.2.2",
    "parse5": "^8.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "overrides": {
    "katex": "$katex",
    "mdast-util-gfm": {
      "mdast-util-gfm-autolink-literal": "2.0.0"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "license": "MIT"
}
